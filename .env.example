# Base de données (local hors Docker : port 5434, cf. docker-compose.yml)
DATABASE_URL=postgresql+psycopg://agenda:agenda@localhost:5435/agenda

# Rappels serveur (SMS/WhatsApp via Twilio ; sans config -> sender log)
REMINDER_LEAD_MIN=60
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sécurité
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
